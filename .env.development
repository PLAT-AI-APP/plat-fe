# NEXT_PUBLIC_BASE_URI=http://localhost:3000
NEXT_PUBLIC_BASE_URI=https://api-dev.plat.so
# AI 채팅(/chat/**) 은 별도 앱이 받는다. 비우면 위 주소를 쓴다.
NEXT_PUBLIC_CHAT_BASE_URI=https://ai-dev.plat.so

# MSW 목업 사용 여부 (enabled | disabled)
# 값을 바꾼 뒤에는 dev 서버를 재시작해야 반영됩니다.
NEXT_PUBLIC_API_MOCKING=disabled

# 검색 엔진 수집 허용 (true 일 때만 연다). 클로즈베타 동안은 비워 둔다.
NEXT_PUBLIC_ALLOW_INDEXING=
# 공유 미리보기 기준 주소. 비우면 https://plat.so
NEXT_PUBLIC_SITE_URL=

# 클로즈베타 안내 띠. 정식 출시 때 off 로 끈다.
NEXT_PUBLIC_BETA_BANNER=

# 점검 모드. on 이면 모든 화면이 점검 안내로 바뀐다.
NEXT_PUBLIC_MAINTENANCE_MODE=
